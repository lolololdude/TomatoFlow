<Window x:Class="TomatoFlow.AdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Tomato Vision"
        Width="560"
        Height="404"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border Background="#0C0B08" BorderBrush="#3D3524" BorderThickness="1.2" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOMATO VISION" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="16" Foreground="{StaticResource AccentLightBrush}" />
                    <TextBlock Text="™" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"
                               Margin="1,3,0,0" />
                    <Border Background="{StaticResource AccentFaintBrush}" CornerRadius="6" Padding="8,3" Margin="12,0,0,0"
                            BorderBrush="{StaticResource AccentDeepBrush}" BorderThickness="1">
                        <TextBlock Text="SPONSORED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Visibility="Hidden" Click="OnSkipClick" Width="34" Height="30" />
            </Grid>

            <Border Grid.Row="1" Background="#070606" CornerRadius="0" ClipToBounds="True">
                <Grid>
                    <vlc:VideoView x:Name="Player" Visibility="Collapsed" />
                    <Grid x:Name="FallbackPanel">
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E1808" Offset="0" />
                                    <GradientStop Color="#0A0906" Offset="0.55" />
                                    <GradientStop Color="#141006" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="FallbackGlow" Width="360" Height="360" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Opacity="0.16">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF5A3C" Offset="0" />
                                    <GradientStop Color="#00FF5A3C" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                            <TextBlock Text="TOMATO FLOW" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                       FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="FallbackSlogan" Text="THE FLOW IS YOURS." FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource AccentLightBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <Border Width="220" Height="6" CornerRadius="3" Background="#282216" Margin="0,24,0,0"
                                    HorizontalAlignment="Center">
                                <Border x:Name="FallbackBar" Width="120" Height="6" CornerRadius="3" Background="{StaticResource TomatoGradient}"
                                        HorizontalAlignment="Left" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="20,0,18,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AdCounter" Text="AD 1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <ProgressBar x:Name="AdProgress" Maximum="100" Value="0" Width="220" HorizontalAlignment="Left" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SkipHint" Text="Skip unlocks in 5" FontSize="10.5" Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="SkipButton" Style="{StaticResource TomatoButton}" Content="Skip ad" Padding="22,10"
                            IsEnabled="False" Click="OnSkipClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
