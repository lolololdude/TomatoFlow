<Window x:Class="TomatoFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tomato Flow"
        Width="1240"
        Height="840"
        MinWidth="1080"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="pack://application:,,,/Assets/tomatoflow.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="18" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="HeroChip" TargetType="Border">
            <Setter Property="Background" Value="#2A130F" />
            <Setter Property="BorderBrush" Value="#4A201A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="RoundRecordButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#26110E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Halo" Width="150" Height="150" Fill="#18F2C14E" />
                            <Border x:Name="Circle" Width="126" Height="126" CornerRadius="63"
                                    Background="{TemplateBinding Background}" BorderBrush="#FF5A3C" BorderThickness="1.6">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF5A3C" BlurRadius="26" ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Width" Value="164" />
                                <Setter TargetName="Halo" Property="Height" Value="164" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundRecordButtonSmall" TargetType="Button" BasedOn="{StaticResource RoundRecordButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Width="44" Height="44" CornerRadius="22"
                                Background="{TemplateBinding Background}" BorderBrush="#6E2B22" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{StaticResource TomatoHoverGradient}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeroLinkButton" TargetType="Button">
            <Setter Property="Background" Value="#1E0D0A" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" Background="{StaticResource BackgroundBrush}" BorderBrush="#3D1D17" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#120A08" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="#2A1511">
                        <Image Source="pack://application:,,,/Assets/tomato.png" Width="24" Height="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TOMATO FLOW" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"
                               Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <Border Style="{StaticResource HeroChip}" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="OFFLINE - FRESH - JUICY" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Border x:Name="EditionBadge" Style="{StaticResource HeroChip}" Margin="8,0,0,0" Padding="8,3"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EditionBadgeText" Text="DEVELOPER BUILD" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#28120F" BorderThickness="0,1,1,0" CornerRadius="0,0,0,18">
                    <Grid Margin="18,22,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <Border Width="104" Height="104" CornerRadius="30" Background="#1E0D0A" BorderBrush="#4A201A" BorderThickness="1">
                                <Grid>
                                    <Grid x:Name="SidebarLogoDefault">
                                        <Image Source="pack://application:,,,/Assets/tomato.png" Width="72" Height="72"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border CornerRadius="30" ClipToBounds="True">
                                        <Image x:Name="SidebarLogoImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="TOMATO FLOW" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20"
                                       Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="FRESH DICTATION" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,26,0,0">
                            <RadioButton x:Name="NavStudio" Style="{StaticResource NavItem}" IsChecked="True" Tag="Studio" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Studio" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSetup" Style="{StaticResource NavItem}" Tag="Setup" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Setup" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStyle" Style="{StaticResource NavItem}" Tag="Style" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Style" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAds" Style="{StaticResource NavItem}" Tag="Ads" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Tomato Ads" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItem}" Tag="Advanced" Checked="Nav_Checked"
                                         Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Advanced" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="About" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="About" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Border Background="#180C09" CornerRadius="12" BorderBrush="#3D1D17" BorderThickness="1" Padding="13,11">
                                <StackPanel>
                                    <TextBlock Text="SHORTCUT" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                    <TextBlock x:Name="SidebarHotkeyText" Text="Ctrl+Alt+D" FontFamily="{StaticResource MonoFont}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{StaticResource AccentLightBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Ellipse x:Name="SidebarStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SidebarStatusText" Text="Ready" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="VersionText" Text="v1.0.0 · Local Whisper Engine" FontSize="10"
                                       Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="30,24,30,18">
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="Studio" Style="{StaticResource DisplayText}" FontSize="27" />
                            <TextBlock x:Name="PageSubtitle" Text="Your voice, your machine, your moment." Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="EnginePill" Background="#10120D" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="13,7" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EnginePillText" Text="ENGINE: LOADING" FontSize="10.5" FontWeight="SemiBold"
                                               Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="HeaderRecordButton" Style="{StaticResource RoundRecordButtonSmall}" Click="RecordButton_Click" ToolTip="Start or stop dictation">
                                <TextBlock x:Name="HeaderRecordGlyph" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFF4EC" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid x:Name="PageHost" Margin="30,0,30,26">
                            <Grid x:Name="StudioPage">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Border CornerRadius="20" BorderBrush="#332C1C" BorderThickness="1" MinHeight="330">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1A160D" Offset="0" />
                                                    <GradientStop Color="#0E0C08" Offset="0.55" />
                                                    <GradientStop Color="#070706" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.35" />
                                                <Ellipse Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         Margin="0,0,-120,0" Opacity="0.12">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#FF5A3C" Offset="0" />
                                                            <GradientStop Color="#00FF5A3C" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Grid Margin="34,30,34,30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="WELCOME TO" Style="{StaticResource CaptionText}"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                        <TextBlock Text="TOMATO FLOW" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                                   FontSize="46" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock x:Name="HeroTagline" Text="Every word a statement. Dictation that stays on your machine."
                                                                   Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,10,0,0" MaxWidth="440"
                                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                                            <Border Style="{StaticResource HeroChip}">
                                                                <TextBlock Text="100% LOCAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource HeroChip}">
                                                                <TextBlock Text="NO ACCOUNT" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource HeroChip}">
                                                                <TextBlock x:Name="HeroModeChip" Text="PASTE MODE" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                                            <Button x:Name="HeroStartButton" Style="{StaticResource TomatoButton}" Content="START DICTATION"
                                                                    Click="RecordButton_Click" />
                            <Button x:Name="HeroAdButton" Style="{StaticResource HeroLinkButton}" Content="PLAY AN AD"
                                    Margin="10,0,0,0" Click="TestAd_Click" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,0,0,0">
                                                        <Button x:Name="RecordButton" Style="{StaticResource RoundRecordButton}" Click="RecordButton_Click">
                                                            <StackPanel>
                                                                <Image x:Name="RecordGlyph" Source="pack://application:,,,/Assets/tomato.png"
                                       Width="62" Height="62" HorizontalAlignment="Center" />
                                                                <TextBlock x:Name="RecordLabel" Text="TAP TO TALK" FontSize="10" FontWeight="Bold"
                                                                           Foreground="#FFF4EC" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                        <UniformGrid x:Name="WaveGrid" Rows="1" Columns="26" Height="40" Width="220" Margin="0,14,0,0" />
                                                        <TextBlock x:Name="WaveStatusText" Text="READY FOR YOUR FLOW" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,7,0" Padding="20,18">
                                                <StackPanel>
                                                    <TextBlock Text="WORDS DICTATED" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                    <TextBlock x:Name="StatWordsText" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                               FontSize="28" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,7,0" Padding="20,18">
                                                <StackPanel>
                                                    <TextBlock Text="SESSIONS" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                    <TextBlock x:Name="StatSessionsText" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                               FontSize="28" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="7,0,0,0" Padding="20,18">
                                                <StackPanel>
                                                    <TextBlock Text="ACTIVE MODEL" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                    <TextBlock x:Name="StatModelText" Text="—" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                               FontSize="18" Margin="0,10,0,0" Foreground="{StaticResource AccentLightBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0" Padding="24,20">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="RECENT FLOW" Style="{StaticResource SectionTitle}" />
                                                    <Button x:Name="ClearHistoryButton" Style="{StaticResource GhostButton}" Content="Clear history"
                                                            HorizontalAlignment="Right" Click="ClearHistory_Click" />
                                                </Grid>
                                                <TextBlock x:Name="HistoryEmptyText" Text="Nothing yet. Hit the mic and start talking."
                                                           Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                                <ItemsControl x:Name="HistoryList" Margin="0,12,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#180C09" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1"
                                                                    CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="70"
                                                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:t}'}" FontSize="10.5"
                                                                                       Foreground="{StaticResource DimBrush}" />
                                                                            <TextBlock Text="·" Margin="7,0" FontSize="10.5" Foreground="{StaticResource DimBrush}" />
                                                                            <TextBlock Text="{Binding WordCount, StringFormat='{}{0} words'}" FontSize="10.5"
                                                                                       Foreground="{StaticResource DimBrush}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                                            ToolTip="Copy again" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                            Click="CopyHistory_Click" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="SetupPage" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Border Style="{StaticResource CardBorder}" Padding="24,22">
                                            <StackPanel>
                                                <TextBlock Text="ENGINE ROOM" Style="{StaticResource SectionTitle}" />
                                                <TextBlock x:Name="HardwareText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <TextBlock x:Name="RecommendText" FontSize="12" Foreground="{StaticResource AccentLightBrush}"
                                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <Grid Margin="0,18,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ModelCombo" SelectionChanged="ModelCombo_SelectionChanged">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding SizeLabel}" Margin="10,0,0,0" FontSize="11"
                                                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <ProgressBar x:Name="ModelProgressBar" Value="0" />
                                                </Grid>
                                                <Grid Margin="0,12,0,0">
                                                    <TextBlock x:Name="ModelStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="InstallModelButton" Style="{StaticResource TomatoButton}" Content="INSTALL MODEL"
                                                                Padding="16,9" Click="InstallModel_Click" />
                                                        <Button x:Name="RemoveModelButton" Style="{StaticResource GhostButton}" Content="Remove"
                                                                Margin="6,0,0,0" Click="RemoveModel_Click" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="EngineRuntimeText" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="VOICE &amp; LANGUAGE" Style="{StaticResource SectionTitle}" />
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="MICROPHONE" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                        <ComboBox x:Name="MicCombo" Margin="0,7,0,0" SelectionChanged="MicCombo_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="LANGUAGE" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                        <ComboBox x:Name="LanguageCombo" Margin="0,7,0,0" SelectionChanged="LanguageCombo_SelectionChanged" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="CUSTOM VOCABULARY" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}"
                                                           Margin="0,18,0,0" />
                                                <TextBox x:Name="VocabularyBox" Margin="0,7,0,0" Height="76" AcceptsReturn="True"
                                                         TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                         LostFocus="VocabularyBox_LostFocus" />
                                                <TextBlock Text="Names, brands, jargon. One per line or comma separated - these nudge the model toward your words."
                                                           Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                <CheckBox x:Name="FillersToggle" Style="{StaticResource ToggleSwitch}" Content="Strip filler words (um, uh, hmm)"
                                                          Margin="0,18,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                <CheckBox x:Name="CapitalizeToggle" Style="{StaticResource ToggleSwitch}" Content="Auto-capitalize the first word"
                                                          Margin="0,12,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="SHORTCUT &amp; OUTPUT" Style="{StaticResource SectionTitle}" />
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="GLOBAL HOTKEY" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                        <Button x:Name="HotkeyButton" Style="{StaticResource DarkButton}" Margin="0,7,0,0"
                                                                Content="Ctrl+Alt+D" Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                                                LostKeyboardFocus="HotkeyButton_LostKeyboardFocus" />
                                                        <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="WHERE IT GOES" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                        <RadioButton x:Name="PasteRadio" GroupName="OutputMode" Style="{StaticResource OptionRadio}"
                                                                     Content="Paste into the app I'm using" Checked="OutputMode_Changed" />
                                                        <RadioButton x:Name="CopyRadio" GroupName="OutputMode" Style="{StaticResource OptionRadio}"
                                                                     Content="Copy to clipboard only" Checked="OutputMode_Changed" />
                                                        <CheckBox x:Name="RestoreClipboardToggle" Style="{StaticResource ToggleSwitch}"
                                                                  Content="Restore my old clipboard after pasting" Margin="0,10,0,0"
                                                                  Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="DESKTOP BEHAVIOR" Style="{StaticResource SectionTitle}" />
                                                <CheckBox x:Name="OrbToggle" Style="{StaticResource ToggleSwitch}" Content="Show the floating tomato on top of everything"
                                                          Margin="0,16,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                <CheckBox x:Name="MinimizeToggle" Style="{StaticResource ToggleSwitch}" Content="Minimize to the system tray"
                                                          Margin="0,12,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                <CheckBox x:Name="CloseTrayToggle" Style="{StaticResource ToggleSwitch}" Content="Keep running in the tray when I close the window"
                                                          Margin="0,12,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                <CheckBox x:Name="StartWithWindowsToggle" Style="{StaticResource ToggleSwitch}" Content="Start Tomato Flow with Windows"
                                                          Margin="0,12,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                <CheckBox x:Name="LaunchMinimizedToggle" Style="{StaticResource ToggleSwitch}" Content="Start minimized in the tray"
                                                          Margin="0,12,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="StylePage" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Border Style="{StaticResource CardBorder}" Padding="24,22">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="140" Height="140" CornerRadius="20" Background="#1E0D0A" BorderBrush="#4A201A" BorderThickness="1">
                                                    <Grid>
                                                        <Grid x:Name="LogoPreviewDefault">
                                                            <Ellipse Width="84" Height="84" Stroke="{StaticResource TomatoGradient}" StrokeThickness="2" />
                                                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Border CornerRadius="20" ClipToBounds="True">
                                                            <Image x:Name="LogoPreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="20,4,0,0">
                                                    <TextBlock Text="YOUR LOGO" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="Drop in a PNG or JPG and it replaces the mic everywhere - sidebar, hero, floating icon, and the app icon vibe."
                                                               Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                        <Button x:Name="ChooseLogoButton" Style="{StaticResource TomatoButton}" Content="CHOOSE LOGO" Padding="16,9" Click="ChooseLogo_Click" />
                                                        <Button x:Name="ClearLogoButton" Style="{StaticResource GhostButton}" Content="Remove" Margin="6,0,0,0" Click="ClearLogo_Click" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="HERO BACKDROP" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Show off an image behind the Studio hero. It will glow behind your flow."
                                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <Border Height="150" CornerRadius="14" Background="#12100B" BorderBrush="{StaticResource LineSoftBrush}"
                                                        BorderThickness="1" Margin="0,14,0,0" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock x:Name="HeroPreviewEmpty" Text="No backdrop selected" Style="{StaticResource MutedText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image x:Name="HeroPreviewImage" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="ChooseHeroButton" Style="{StaticResource TomatoButton}" Content="CHOOSE BACKDROP" Padding="16,9" Click="ChooseHero_Click" />
                                                    <Button x:Name="ClearHeroButton" Style="{StaticResource GhostButton}" Content="Remove" Margin="6,0,0,0" Click="ClearHero_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="TOMATO WALL" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock x:Name="GalleryCountText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="Add as many images as you want. They get displayed around the app for maximum tomato energy."
                                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="AddGalleryButton" Style="{StaticResource TomatoButton}" Content="ADD IMAGES" Padding="16,9" Click="AddGallery_Click" />
                                                    <Button x:Name="ClearGalleryButton" Style="{StaticResource GhostButton}" Content="Clear wall" Margin="6,0,0,0" Click="ClearGallery_Click" />
                                                </StackPanel>
                                                <WrapPanel x:Name="GalleryPanel" Margin="0,16,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="AdsPage" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Border x:Name="AdSettingsCard" Style="{StaticResource CardBorder}" Padding="24,22">
                                            <StackPanel>
                                                <TextBlock Text="TOMATO VISION" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Short ads from your own video folders. Every ad can be skipped after the countdown."
                                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <CheckBox x:Name="AdsToggle" Style="{StaticResource ToggleSwitch}" Content="Enable Tomato Vision"
                                                          Margin="0,16,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="WHEN TO PLAY" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                        <ComboBox x:Name="AdFrequencyCombo" Margin="0,7,0,0" SelectionChanged="AdFrequencyCombo_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                        <TextBlock Text="SKIP AFTER" Style="{StaticResource CaptionText}" Foreground="{StaticResource DimBrush}" />
                                                        <ComboBox x:Name="AdSkipCombo" Margin="0,7,0,0" SelectionChanged="AdSkipCombo_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                                        <CheckBox x:Name="AdSoundToggle" Style="{StaticResource ToggleSwitch}" Content="Ad sound"
                                                                  Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                    <Button x:Name="TestAdButton" Style="{StaticResource TomatoButton}" Content="PLAY AN AD NOW" Padding="18,10" Click="TestAd_Click" />
                                                    <Button x:Name="OpenAdsFolderButton" Style="{StaticResource GhostButton}" Content="Open ads folder" Margin="6,0,0,0" Click="OpenAdsFolder_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="AD PLAYLIST" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock x:Name="AdCountText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="Drop any video into the Tomato Ads folder and it becomes an ad. MP4, MKV, AVI, MOV, WMV, and WEBM all work."
                                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="AddAdButton" Style="{StaticResource TomatoButton}" Content="ADD VIDEO FILES" Padding="16,9" Click="AddAd_Click" />
                                                    <Button x:Name="AddAdFolderButton" Style="{StaticResource DarkButton}" Content="ADD FOLDER" Margin="6,0,0,0" Padding="14,9" Click="AddAdFolder_Click" />
                                                    <Button x:Name="RefreshAdsButton" Style="{StaticResource DarkButton}" Content="REFRESH" Margin="6,0,0,0" Padding="14,9" Click="RefreshAds_Click" />
                                                    <Button x:Name="RestoreHiddenButton" Style="{StaticResource DarkButton}" Content="RESTORE HIDDEN" Margin="6,0,0,0"
                                                            Padding="14,9" Visibility="Collapsed" Click="RestoreHidden_Click" />
                                                    <Button x:Name="RemoveBundledButton" Style="{StaticResource DarkButton}" Content="REMOVE BUNDLED ADS" Margin="6,0,0,0"
                                                            Padding="14,9" Visibility="Collapsed" Click="RemoveBundledAds_Click" />
                                                </StackPanel>
                                                <StackPanel x:Name="AdListPanel" Margin="0,14,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="AdvancedPage" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Border Style="{StaticResource CardBorder}" Padding="24,22">
                                            <StackPanel>
                                                <TextBlock Text="BUILD &amp; DIAGNOSTICS" Style="{StaticResource SectionTitle}" />
                                                <TextBlock x:Name="AdvancedBuildText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <Border Background="#180C09" CornerRadius="12" BorderBrush="#3D1D17" BorderThickness="1"
                                                        Padding="14,12" Margin="0,14,0,0">
                                                    <TextBlock x:Name="AdvancedInfoText" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                                </Border>
                                                <WrapPanel Margin="0,16,0,0">
                                                    <Button Style="{StaticResource TomatoButton}" Content="OPEN LOG" Padding="16,9" Click="OpenLog_Click" />
                                                    <Button Style="{StaticResource DarkButton}" Content="OPEN DATA FOLDER" Margin="6,0,0,0"
                                                            Padding="14,9" Click="OpenDataFolder_Click" />
                                                    <Button Style="{StaticResource DarkButton}" Content="COPY DIAGNOSTICS" Margin="6,0,0,0"
                                                            Padding="14,9" Click="CopyDiagnostics_Click" />
                                                    <Button Style="{StaticResource DarkButton}" Content="RESET MIC POSITION" Margin="6,0,0,0"
                                                            Padding="14,9" Click="ResetOrb_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="AD DEBUGGING" Style="{StaticResource SectionTitle}" />
                                                <TextBlock x:Name="AdvancedAdsText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,16,0,0">
                                                    <Button Style="{StaticResource TomatoButton}" Content="PLAY A TEST AD" Padding="16,9" Click="TestAd_Click" />
                                                    <Button Style="{StaticResource DarkButton}" Content="RELOAD PLAYLIST" Margin="6,0,0,0"
                                                            Padding="14,9" Click="ReloadAds_Click" />
                                                    <Button Style="{StaticResource DarkButton}" Content="RESTORE HIDDEN ADS" Margin="6,0,0,0"
                                                            Padding="14,9" Click="RestoreHidden_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Padding="24,22" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="ENGINE" Style="{StaticResource SectionTitle}" />
                                                <TextBlock x:Name="AdvancedEngineText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,16,0,0">
                                                    <Button Style="{StaticResource TomatoButton}" Content="WARM UP ENGINE" Padding="16,9" Click="WarmEngine_Click" />
                                                    <Button Style="{StaticResource DarkButton}" Content="OPEN MODEL FOLDER" Margin="6,0,0,0"
                                                            Padding="14,9" Click="OpenModelFolder_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="AboutPage" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Border Style="{StaticResource CardBorder}" Padding="24,22">
                                            <StackPanel>
                                                <TextBlock Text="FRESH DICTATION" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Tomato Flow is a free, offline, Windows-only voice dictation studio. It runs OpenAI Whisper locally through whisper.cpp. Nothing you say is uploaded. There is no account, no subscription, and no tracking."
                                                           Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="Hold the flow:" FontWeight="SemiBold" Margin="0,16,0,0" />
                                                <TextBlock Text="1. Press your hotkey to start listening. Press it again to stop." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                <TextBlock Text="2. Tomato decodes your words and pastes them into whatever app you were using." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                <TextBlock Text="3. If the target app cannot be reached, the words land on your clipboard instead." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                <TextBlock Text="4. Click the floating mic to do the same thing without touching the keyboard." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                <TextBlock Text="Credits: Whisper by OpenAI, whisper.cpp by Georgi Gerganov, Whisper.net by Sandro Hanea, NAudio by Mark Heath. Tomato Flow wraps them with love and tomatoes."
                                                           Style="{StaticResource MutedText}" Margin="0,18,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="Not affiliated with any artist or label. It is a parody of cloud dictation apps, built for one fan and his machine."
                                                           Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,26" CornerRadius="12" Padding="18,12" BorderBrush="{StaticResource AccentDeepBrush}" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#F014120D" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ToastText" Text="" Margin="10,0,0,0" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SetupOverlay" Background="#F2080807" CornerRadius="18" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                                <Border Width="86" Height="86" CornerRadius="26" Background="#2A1511" HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/tomato.png" Width="62" Height="62"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="WARMING UP THE FLOW" Style="{StaticResource DisplayText}" FontSize="24"
                                           HorizontalAlignment="Center" Margin="0,20,0,0" />
                                <TextBlock x:Name="OverlayStatusText" Text="Finding the best Whisper model for this PC..."
                                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                                <ProgressBar x:Name="OverlayProgressBar" Value="0" Margin="0,20,0,0" />
                                <TextBlock x:Name="OverlayProgressText" Text="" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button x:Name="OverlayCancelButton" Style="{StaticResource DarkButton}" Content="Cancel"
                                            Click="OverlayCancel_Click" />
                                    <Button x:Name="OverlayRetryButton" Style="{StaticResource TomatoButton}" Content="TRY AGAIN"
                                            Margin="8,0,0,0" Visibility="Collapsed" Click="OverlayRetry_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
